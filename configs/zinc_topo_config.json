{
  "dataset_name": "ZINC",
  "num_epochs": 500,
  "max_to_keep": 1,
  "gpu": "0",
  "num_exp": 1,
  "exp_name": "zinc_topo_experiment",
  "val_exist": true,
  "target_param": false,

  "architecture": {
    "block_features": [64, 64],
    "depth_of_mlp": 2,
    "new_suffix": true,
    "use_topology": true,
    "topo_hidden_dim": 32,
    "topo_max_ph_dim": 1,
    "topo_num_stats": 32,
    "topo_max_simplex_dim": 2
  },

  "hyperparams": {
    "learning_rate": 0.001,
    "decay_rate": 0.5,
    "batch_size": 64,
    "optimizer": "adam"
  }
}
